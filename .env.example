# Copy to .env for local development (git-ignored). All values optional.

# --- Artifact storage ---
ARTIFACT_STORE=local            # local | s3
ARTIFACT_DIR=artifacts          # local store base dir
# ARTIFACT_S3_BUCKET=my-bucket  # required when ARTIFACT_STORE=s3
# ARTIFACT_S3_PREFIX=artifacts
# AWS_REGION=us-east-1

# --- GenAI / RAG layer ---
LLM_ENABLED=true
LLM_PROVIDER=anthropic          # anthropic | bedrock | disabled
LLM_MODEL=claude-sonnet-5       # anthropic id, or a Bedrock model id
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0.2
# ANTHROPIC_API_KEY=sk-ant-...  # required for LLM_PROVIDER=anthropic

# --- Retrieval / serving ---
ENABLE_RERANK=false             # cross-encoder rerank (slower, more precise)
DEFAULT_TOP_K=10
