# Copy to .env for local development (git-ignored). All values optional.
# Keep comments on their own lines: the parser in src/settings.py does not
# strip trailing "#" comments from values.

# --- Artifact storage ---
# ARTIFACT_STORE: local | s3
ARTIFACT_STORE=local
ARTIFACT_DIR=artifacts
# ARTIFACT_S3_BUCKET is required when ARTIFACT_STORE=s3
# ARTIFACT_S3_BUCKET=my-bucket
# ARTIFACT_S3_PREFIX=artifacts
# AWS_REGION=us-east-1

# --- GenAI / RAG layer ---
# LLM_PROVIDER: anthropic | bedrock | disabled
# Use "disabled" to run without an API key (deterministic fallbacks).
LLM_ENABLED=true
LLM_PROVIDER=disabled
# Anthropic model id, or a Bedrock model id when LLM_PROVIDER=bedrock
LLM_MODEL=claude-sonnet-5
LLM_MAX_TOKENS=512
# Required for LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# --- Retrieval / serving ---
# ENABLE_RERANK: cross-encoder rerank (slower, more precise)
ENABLE_RERANK=false
DEFAULT_TOP_K=10
