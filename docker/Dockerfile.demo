# syntax=docker/dockerfile:1
# ---------------------------------------------------------------------------
# Self-contained demo image: one service serving the web UI *and* the API,
# with a small TF-IDF catalog baked in. Small enough for free hosting tiers
# (Render / Railway / Fly). No torch / sentence-transformers / faiss.
# ---------------------------------------------------------------------------

# 1) Build the frontend (calls same-origin /api).
FROM node:22-alpine AS web
WORKDIR /web
COPY frontend/package.json frontend/package-lock.json* ./
RUN npm ci
COPY frontend/ ./
ENV VITE_API_URL=/api
RUN npm run build


# 2) Python runtime: install lite deps, bake the demo artifacts, serve.
FROM python:3.11-slim AS runtime
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    ARTIFACT_STORE=local \
    ARTIFACT_DIR=/app/artifacts \
    STATIC_DIR=/app/static \
    LLM_PROVIDER=disabled

WORKDIR /app
COPY requirements-lite.txt .
RUN pip install --upgrade pip && pip install -r requirements-lite.txt

COPY src/ ./src/
COPY config/ ./config/
COPY examples/ ./examples/
COPY scripts/build_demo_artifacts.py ./scripts/build_demo_artifacts.py
COPY --from=web /web/dist ./static

# Bake the TF-IDF catalog + 2-D map into the image.
RUN python scripts/build_demo_artifacts.py

RUN useradd --create-home --uid 10001 appuser && chown -R appuser /app
USER appuser

EXPOSE 8000
# Hosting platforms inject $PORT; default to 8000 locally.
ENV PORT=8000
CMD ["sh", "-c", "uvicorn src.api.allinone:app --host 0.0.0.0 --port ${PORT}"]
