# syntax=docker/dockerfile:1
# ---------------------------------------------------------------------------
# Streamlit demo UI. Talks to the API service over HTTP (RECSYS_API_URL).
# ---------------------------------------------------------------------------
FROM python:3.11-slim

ENV PIP_NO_CACHE_DIR=1 \
    PYTHONUNBUFFERED=1 \
    RECSYS_API_URL=http://api:8000

WORKDIR /app

COPY requirements-ui.txt .
RUN pip install --upgrade pip && pip install -r requirements-ui.txt

COPY app/ ./app/
COPY src/ ./src/
COPY config/ ./config/

RUN useradd --create-home --uid 10002 uiuser && chown -R uiuser /app
USER uiuser

EXPOSE 8501
CMD ["streamlit", "run", "app/streamlit_app.py", "--server.port=8501", "--server.address=0.0.0.0"]
